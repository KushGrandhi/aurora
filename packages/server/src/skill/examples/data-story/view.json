 "queries": {
  "by_hour": {
   "sql": "SELECT hour, label, trips FROM trips ORDER BY hour"
  },
  "morning": {
   "sql": "SELECT sum(trips) FILTER (WHERE hour IN (7, 8)) / sum(trips) AS share FROM trips"
  },
  "peak": {
   "sql": "SELECT label, trips FROM trips ORDER BY trips DESC LIMIT 1"
  },
  "night": {
   "sql": "SELECT max(trips) AS trips FROM trips WHERE hour < 6"
  },
  "commute": {
   "sql": "SELECT share FROM riders WHERE kind = 'commute'"
  },
  "errand": {
   "sql": "SELECT share FROM riders WHERE kind = 'errand'"
  },
  "leisure": {
   "sql": "SELECT share FROM riders WHERE kind = 'leisure'"
  }
 },
