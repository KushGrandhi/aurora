  "queries": {
    "attention": {
      "sql": "SELECT CASE WHEN over_c > 0 THEN room || ' is over its limit' ELSE 'All rooms within their limits' END AS headline, CASE WHEN over_c > 0 THEN 'It reads ' || temp_c || ' °C, ' || round(over_c, 1) || ' °C too warm. Check the door seal and the compressor before the stock thaws.' ELSE 'The closest is ' || room || ', ' || round(-over_c, 1) || ' °C inside its limit.' END AS detail, round(over_c, 1) AS worst_over_c FROM (SELECT room, temp_c, limit_c, temp_c - limit_c AS over_c FROM readings WHERE hour = (SELECT max(hour) FROM readings)) ORDER BY over_c DESC LIMIT 1"
    },
    "counts": {
      "sql": "SELECT count(*) FILTER (WHERE over_c > 0) AS rooms_over_limit, count(*) AS rooms FROM (SELECT room, temp_c, limit_c, temp_c - limit_c AS over_c FROM readings WHERE hour = (SELECT max(hour) FROM readings))"
    },
    "now": {
      "sql": "SELECT room AS \"Room\", temp_c AS \"Now (°C)\", limit_c AS \"Limit (°C)\", round(over_c, 1) AS \"Over limit (°C)\", CASE WHEN over_c > 0 THEN 'over limit' WHEN over_c > -1 THEN 'close' ELSE 'ok' END AS \"Status\" FROM (SELECT room, temp_c, limit_c, temp_c - limit_c AS over_c FROM readings WHERE hour = (SELECT max(hour) FROM readings)) ORDER BY over_c DESC"
    },
    "headroom": {
      "sql": "SELECT r.room, r.hour, round(r.temp_c - r.limit_c, 1) AS above_limit_c, CASE WHEN l.temp_c > l.limit_c THEN 'over limit' ELSE 'ok' END AS state FROM readings r JOIN readings l ON l.room = r.room AND l.hour = (SELECT max(hour) FROM readings) ORDER BY r.room, r.hour"
    }
  },
